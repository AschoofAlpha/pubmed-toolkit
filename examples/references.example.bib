% Example bibliography for `pubmed-toolkit verify`.
%
% Entries 1-3 are correct and should verify cleanly.
% Entries 4-6 each carry a deliberate, realistic defect so you can see what
% each class of finding looks like in the report.
%
%   python -m pubmed_toolkit verify examples/references.example.bib --email you@example.com

% --- correct ---------------------------------------------------------------

@article{bass2014,
  title   = {Comprehensive molecular characterization of gastric adenocarcinoma},
  author  = {Bass, Adam J. and Thorsson, Vesteinn and Shmulevich, Ilya},
  journal = {Nature},
  volume  = {513},
  number  = {7517},
  pages   = {202--209},
  year    = {2014},
  doi     = {10.1038/nature13480},
  pmid    = {25079317}
}

@article{dixon2012,
  title   = {Ferroptosis: an iron-dependent form of nonapoptotic cell death},
  author  = {Dixon, Scott J. and Lemberg, Kathryn M. and Stockwell, Brent R.},
  journal = {Cell},
  volume  = {149},
  number  = {5},
  pages   = {1060--1072},
  year    = {2012},
  doi     = {10.1016/j.cell.2012.03.042},
  pmid    = {22632970}
}

@article{jinek2012,
  title   = {A programmable dual-RNA-guided DNA endonuclease in adaptive bacterial immunity},
  author  = {Jinek, Martin and Chylinski, Krzysztof and Charpentier, Emmanuelle},
  journal = {Science},
  volume  = {337},
  number  = {6096},
  pages   = {816--821},
  year    = {2012},
  doi     = {10.1126/science.1225829}
}

% --- deliberately defective -------------------------------------------------

% Wrong journal. The paper is real and the DOI is correct, but it appeared in
% Virology, not Antiviral Research. This is the "citation exists but the
% details are wrong" case that existence-only checkers pass.
@article{kennedy2015_wrongjournal,
  title   = {Suppression of hepatitis B virus DNA accumulation in chronically infected cells using a bacterial CRISPR/Cas RNA-guided DNA endonuclease},
  author  = {Kennedy, Edward M.},
  journal = {Antiviral Research},
  year    = {2015},
  doi     = {10.1016/j.virol.2014.12.001}
}

% Mismatched identifiers: the DOI is Bass 2014 (Nature), the PMID is Dixon 2012
% (Cell). Both identifiers resolve, so any tool that only checks existence
% reports this entry as fine. The bidirectional check catches it.
@article{frankenstein_entry,
  title   = {Comprehensive molecular characterization of gastric adenocarcinoma},
  author  = {Bass, Adam J.},
  journal = {Nature},
  year    = {2014},
  doi     = {10.1038/nature13480},
  pmid    = {22632970}
}

% A DOI that was never registered. This is the signature of a fabricated
% citation, and it is reported under "Unregistered identifiers" -- distinct
% from the "Unresolved" section below, which is for works that are merely
% absent from the indexes.
@article{fabricated_doi,
  title   = {Ferroptosis reversal by targeted mitochondrial reprogramming},
  author  = {Nakamura, Kenji},
  journal = {Nature Metabolism},
  year    = {2024},
  doi     = {10.1038/s42255-024-99999-x}
}

% Not indexed anywhere. Expected to come back unresolved rather than wrong --
% textbooks and national guidelines are legitimately absent from CrossRef.
@book{textbook_example,
  title     = {Human Parasitology},
  author    = {Zhu, Ming},
  publisher = {Example University Press},
  year      = {2018}
}
